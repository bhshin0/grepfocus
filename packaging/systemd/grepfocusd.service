[Unit]
Description=GrepFocus blocker daemon
Documentation=https://github.com/bhshin0/grepfocus
After=network-pre.target
DefaultDependencies=no
# Stronger restart resilience: keep restarting even if it crashes a lot.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/grepfocusd
Restart=always
RestartSec=1

# The daemon must edit /etc/hosts and /var/lib/grepfocus, so we cannot use
# ProtectSystem=strict. We still apply the hardening that's compatible with
# our needs.
NoNewPrivileges=no
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

# Logs go to journal. Use `journalctl -u grepfocusd` to read them.
StandardOutput=journal
StandardError=journal
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
