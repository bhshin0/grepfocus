{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the GrepFocus app window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "allow-list-blocks",
    "allow-add-block",
    "allow-update-block",
    "allow-delete-block",
    "allow-start-block",
    "allow-get-status",
    "allow-get-usage-stats",
    "allow-list-schedules",
    "allow-add-schedule",
    "allow-update-schedule",
    "allow-delete-schedule",
    "allow-set-password",
    "allow-set-license",
    "allow-set-settings",
    "allow-unlock",
    "allow-take-break",
    "allow-get-break-challenge",
    "allow-start-pomodoro",
    "allow-stop-pomodoro",
    "allow-app-env",
    "allow-install-service",
    "allow-uninstall-service",
    "allow-get-update-info",
    "allow-acknowledge-update-check",
    "allow-check-for-update",
    "allow-set-update-check-enabled",
    "allow-dismiss-update",
    "allow-open-url"
  ]
}
