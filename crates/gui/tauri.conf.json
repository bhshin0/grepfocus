{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frostbite",
  "version": "0.1.0",
  "identifier": "io.frostbite.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Frostbite",
        "width": 900,
        "height": 640,
        "minWidth": 600,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "Utility"
  }
}
