# Toolchain image for building the GrepFocus AppImage (see build-appimage.sh).
#
# Ubuntu 22.04 (glibc 2.35) rather than the deb builder's 24.04 (glibc 2.39):
# an AppImage's whole point is reach, and it will refuse to start on any host
# with an older glibc than it was built against. 22.04 still ships
# libwebkit2gtk-4.1 (2.50), so we keep the same webkit ABI as the deb while
# lowering the glibc floor.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Build/-dev libs (same webkit/gtk/soup set as the deb image) plus the extra
# tooling the Tauri AppImage bundler + linuxdeploy need:
#   libfuse2                     AppImage runtime / linuxdeploy
#   file, wget                   linuxdeploy invokes these
#   desktop-file-utils           .desktop validation
#   librsvg2-bin / -common / -dev  SVG gdk-pixbuf loader + its librsvg-2.0.pc,
#                                  which linuxdeploy-plugin-gtk needs to bundle
#                                  the SVG loader (without the .pc the gtk plugin
#                                  aborts "no 'libdir' variable for librsvg-2.0")
#   patchelf                       REQUIRED by linuxdeploy (rpath rewriting) —
#                                  without it the bundle step dies "failed to run
#                                  linuxdeploy"
#   libgdk-pixbuf2.0-bin           gdk-pixbuf-query-loaders, used by
#                                  linuxdeploy-plugin-gtk to bundle pixbuf loaders
#   libglib2.0-bin                 glib-compile-schemas, used by the gtk plugin
#   libayatana-appindicator3-dev   the tray lib PLUS its ayatana-appindicator3-0.1
#                                  pkg-config .pc file — tauri's AppImage bundler
#                                  locates the lib to bundle via `pkg-config`, so
#                                  the runtime-only package is not enough (it has
#                                  no .pc and the bundler panics "Can't detect any
#                                  appindicator library"). -dev pulls the runtime
#                                  lib in as a dependency.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        ca-certificates \
        curl \
        wget \
        file \
        desktop-file-utils \
        librsvg2-bin \
        librsvg2-common \
        librsvg2-dev \
        patchelf \
        libgdk-pixbuf2.0-bin \
        libglib2.0-bin \
        libfuse2 \
        libgtk-3-dev \
        libwebkit2gtk-4.1-dev \
        libsoup-3.0-dev \
        libjavascriptcoregtk-4.1-dev \
        libayatana-appindicator3-dev \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain (same rationale as the deb image: the workspace can need a
# newer cargo than apt ships).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# The Tauri CLI drives the AppImage bundle (`cargo tauri build`). Not a project
# dependency — installed here like the README instructs for local builds.
RUN cargo install tauri-cli --version "^2.0" --locked

# Node + pnpm for the UI build (embedded into the GUI at compile time).
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm

# appimagetool: used by build-appimage.sh to repack the AppDir after we drop the
# bundled libwayland-egl.so.1 — that Ubuntu-built lib is incompatible with other
# hosts' Mesa libEGL and makes webkit abort ("Could not create default EGL
# display: EGL_BAD_PARAMETER"); the host's own libwayland-egl must be used.
RUN curl -fsSL -o /usr/local/bin/appimagetool \
        https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
    && chmod +x /usr/local/bin/appimagetool

WORKDIR /src
